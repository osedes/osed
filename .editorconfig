# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# YAML files
[*.yml]
indent_style = space
indent_size = 2
max_line_length = 80

[*.yaml]
indent_style = space
indent_size = 2
max_line_length = 80

# Python files
[*.py]
indent_style = space
indent_size = 2
max_line_length = 80

# Markdown files
[*.md]
indent_style = space
indent_size = 2
max_line_length = 80

# JSON files
[*.json]
indent_style = space
indent_size = 2
max_line_length = 80

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2
max_line_length = 80

# Makefiles
[Makefile]
indent_style = tab
