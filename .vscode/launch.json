{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) osed",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/osed_cli",
      "args": [],
      "stopAtEntry": false,
      // Automatically build the project before launching the debugger.
      "preLaunchTask": "CMake: build",
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
          {
              "description": "Enable pretty-printing for gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
          {
              "description": "Set Disassembly Flavor to Intel",
              "text": "-gdb-set disassembly-flavor intel",
              "ignoreFailures": true
          }
      ]
    },
    {
      "name": "Python: osed_cli",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/osed_cli.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      // Example arguments for debugging the 'validate' command.
      // You can change these to test other commands like 'lint' or 'generate'.
      "args": [
        "validate",
        "--file", "osed.yaml"
      ]
    }
  ]
}
