{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "conan: install",
      "type": "shell",
      "command": "conan",
      "args": [
        "install",
        ".",
        "--output-folder=${workspaceFolder}/build",
        "--build=missing"
      ],
      "problemMatcher": [],
      "detail": "Install Conan dependencies for the project."
    }
  ]
}